{
  "name": "paperclip-openrouter",
  "version": "0.1.1",
  "description": "Paperclip external adapter for OpenRouter — run any of OpenRouter's 300+ models as a tool-loop agent. No local CLI. Live model catalog, per-run cost, credit-balance reporting, and Anthropic/Gemini prompt caching.",
  "type": "module",
  "license": "MIT",
  "author": "HLLMR",
  "homepage": "https://github.com/HLLMR/paperclip-openrouter#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HLLMR/paperclip-openrouter.git"
  },
  "bugs": {
    "url": "https://github.com/HLLMR/paperclip-openrouter/issues"
  },
  "keywords": [
    "paperclip",
    "paperclip-adapter",
    "openrouter",
    "llm",
    "ai-agent",
    "adapter",
    "anthropic",
    "prompt-caching",
    "orchestration"
  ],
  "paperclip": {
    "adapterUiParser": "1.0.0"
  },
  "exports": {
    ".": "./dist/index.js",
    "./server": "./dist/server/index.js",
    "./ui-parser": "./dist/ui-parser.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "tsc && node scripts/run-tests.mjs",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@paperclipai/adapter-utils": "^2026.325.0"
  },
  "devDependencies": {
    "@types/node": "^24.6.0",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20"
  }
}
